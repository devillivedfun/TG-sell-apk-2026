{
  "name": "tg-mode-sell-bot",
  "version": "1.0.0",
  "description": "Telegram Stars sales bot for Android application distribution on Vercel",
  "main": "api/telegram.js",
  "type": "module",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "webhook:set": "node scripts/setWebhook.js",
    "webhook:info": "node scripts/getWebhookInfo.js",
    "webhook:delete": "node scripts/deleteWebhook.js"
  },
  "keywords": [
    "telegram",
    "telegram-bot",
    "telegram-stars",
    "grammy",
    "mongodb",
    "vercel",
    "serverless",
    "digital-goods",
    "ecommerce"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "dotenv": "^18.0.8",
    "grammy": "^1.46.0",
    "mongodb": "^7.7.0",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "vitest": "^5.0.5"
  }
}
